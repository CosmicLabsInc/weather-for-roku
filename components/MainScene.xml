<?xml version="1.0" encoding="UTF-8"?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="MainScene.brs" />

    <children>
        <Poster
            id="background"
            width="1280"
            height="720"
            uri="pkg:/images/bg_gradient.png"
            loadDisplayMode="scaleToFill" />

        <ChannelStore id="channelStore" />

        <!-- ================= PAYWALL ================= -->
        <Group id="paywallScreen" visible="false">
            <Poster id="paywallPanel" translation="[320, 60]" width="640" height="600" uri="pkg:/images/ui/panel.png" />

            <Poster id="paywallIcon" translation="[592, 96]" width="96" height="96" uri="pkg:/images/brand_icon.png" loadDisplayMode="scaleToFit" />

            <Label
                id="paywallTitle"
                translation="[320, 206]"
                width="640"
                horizAlign="center"
                text="Weather"
                font="font:LargeBoldSystemFont"
                color="0xF8FAFCFF" />

            <Label
                id="paywallSubtitle"
                translation="[320, 258]"
                width="640"
                horizAlign="center"
                text="Unlock the full ad-free forecast"
                font="font:MediumSystemFont"
                color="0x94A3B8FF" />

            <Label
                id="paywallPrice"
                translation="[320, 312]"
                width="640"
                horizAlign="center"
                text="One-time purchase — yours forever, no subscription"
                font="font:SmallSystemFont"
                color="0x7DD3FCFF" />

            <Group id="payButtons" translation="[460, 372]">
                <Poster id="payBg0" translation="[0, 0]"  width="360" height="64" uri="pkg:/images/ui/pay_btn.png" />
                <Poster id="payBg1" translation="[0, 80]" width="360" height="64" uri="pkg:/images/ui/pay_btn.png" />

                <Poster id="payFocus" translation="[-12, -12]" width="384" height="88" uri="pkg:/images/ui/pay_btn_focus.png" />

                <Label id="payLabel0" translation="[0, 0]"  width="360" height="64" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" text="Unlock" color="0x0B1220FF" />
                <Label id="payLabel1" translation="[0, 80]" width="360" height="64" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" text="Restore purchase" color="0xF8FAFCFF" />
            </Group>

            <Label
                id="paywallStatus"
                translation="[320, 566]"
                width="640"
                horizAlign="center"
                text=""
                font="font:SmallSystemFont"
                color="0x64748BFF" />
        </Group>

        <!-- ================= ZIP ENTRY ================= -->
        <Group id="zipScreen" visible="false">
            <Poster id="entryPanel" translation="[320, 60]" width="640" height="600" uri="pkg:/images/ui/panel.png" />

            <Poster id="brandIcon" translation="[592, 82]" width="96" height="96" uri="pkg:/images/brand_icon.png" loadDisplayMode="scaleToFit" />

            <Label
                id="titleLabel"
                translation="[320, 188]"
                width="640"
                horizAlign="center"
                text="Weather"
                font="font:LargeBoldSystemFont"
                color="0xF8FAFCFF" />

            <Label
                id="subtitleLabel"
                translation="[320, 236]"
                width="640"
                horizAlign="center"
                text="Enter your US ZIP code"
                font="font:MediumSystemFont"
                color="0x94A3B8FF" />

            <Group id="digitGroup" translation="[462, 284]">
                <Poster id="digitBox0" translation="[0, 0]"   width="60" height="74" uri="pkg:/images/ui/digit.png" />
                <Poster id="digitBox1" translation="[74, 0]"  width="60" height="74" uri="pkg:/images/ui/digit.png" />
                <Poster id="digitBox2" translation="[148, 0]" width="60" height="74" uri="pkg:/images/ui/digit.png" />
                <Poster id="digitBox3" translation="[222, 0]" width="60" height="74" uri="pkg:/images/ui/digit.png" />
                <Poster id="digitBox4" translation="[296, 0]" width="60" height="74" uri="pkg:/images/ui/digit.png" />

                <Poster id="digitActive0" translation="[-10, -10]"  width="80" height="94" uri="pkg:/images/ui/digit_active.png" visible="false" />
                <Poster id="digitActive1" translation="[64, -10]"   width="80" height="94" uri="pkg:/images/ui/digit_active.png" visible="false" />
                <Poster id="digitActive2" translation="[138, -10]"  width="80" height="94" uri="pkg:/images/ui/digit_active.png" visible="false" />
                <Poster id="digitActive3" translation="[212, -10]"  width="80" height="94" uri="pkg:/images/ui/digit_active.png" visible="false" />
                <Poster id="digitActive4" translation="[286, -10]"  width="80" height="94" uri="pkg:/images/ui/digit_active.png" visible="false" />

                <Label id="digit0" translation="[0, 0]"   width="60" height="74" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="0xF8FAFCFF" />
                <Label id="digit1" translation="[74, 0]"  width="60" height="74" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="0xF8FAFCFF" />
                <Label id="digit2" translation="[148, 0]" width="60" height="74" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="0xF8FAFCFF" />
                <Label id="digit3" translation="[222, 0]" width="60" height="74" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="0xF8FAFCFF" />
                <Label id="digit4" translation="[296, 0]" width="60" height="74" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="0xF8FAFCFF" />
            </Group>

            <NumPad id="numPad" translation="[482, 376]" />

            <Label
                id="statusLabel"
                translation="[320, 626]"
                width="640"
                horizAlign="center"
                text="Use the arrows and OK. Select GO when done."
                font="font:SmallSystemFont"
                color="0x64748BFF" />
        </Group>

        <!-- ================= LOADING ================= -->
        <Group id="loadingScreen" visible="true">
            <BusySpinner id="spinner" translation="[590, 268]" uri="pkg:/images/ui/spinner.png" />
            <Label
                id="loadingLabel"
                translation="[0, 400]"
                width="1280"
                horizAlign="center"
                text="Fetching your forecast..."
                font="font:MediumSystemFont"
                color="0x94A3B8FF" />
            <Timer id="loadTimer" repeat="false" duration="20" />
        </Group>

        <!-- ================= FORECAST ================= -->
        <Group id="forecastScreen" visible="false">
            <Label
                id="locationLabel"
                translation="[0, 32]"
                width="1280"
                horizAlign="center"
                text=""
                font="font:LargeBoldSystemFont"
                color="0xF8FAFCFF" />

            <Label
                id="zipLabel"
                translation="[0, 78]"
                width="1280"
                horizAlign="center"
                text=""
                font="font:SmallSystemFont"
                color="0x7DD3FCFF" />

            <Group id="forecastRow" translation="[0, 112]" />

            <Group id="hourlyBar" visible="false">
                <Poster id="hourlyPanel" translation="[91, 494]" width="1098" height="130" uri="pkg:/images/ui/hourly.png" />
                <Group id="hourlyRow" translation="[91, 508]" />
            </Group>

            <Label
                id="footerLabel"
                translation="[0, 650]"
                width="1280"
                horizAlign="center"
                text="Press * to change ZIP code"
                font="font:SmallSystemFont"
                color="0x475569FF" />
        </Group>
    </children>
</component>
